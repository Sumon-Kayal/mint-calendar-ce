<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2014 Igor Gnatenko <ignatenko@src.gnome.org> -->
<component type="desktop-application">
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <id>@appid@</id>

  <developer id="io.github.sumon_kayal">
    <name>Sumon Kayal</name>
  </developer>

  <name>Mint Calendar CE</name>
  <summary>Manage your schedule</summary>

  <description>
    <p>
      Mint Calendar CE is a community-maintained, Linux Mint-flavored fork of
      GNOME Calendar, rebased on upstream GNOME Calendar's stable v50 release and packaged
      independently for distribution outside the GNOME and Linux Mint release channels. All
      credit for the underlying application goes to the GNOME Calendar authors and the Linux
      Mint team.
    </p>
    <p>
      GNOME Calendar is an elegant tool to help you plan and stay on top of your schedule for
      upcoming days and weeks, whether your months are filled with meetings and appointments,
      public events, travel logistics, or other commitments in your life.
    </p>
    <p>
      Easily create and manage unlimited calendars and events with GNOME Calendar's infinite
      scrolling month view, week timetable, and scheduling list view.
    </p>
    <p>
      Integrating the latest GNOME technologies and design best practices, GNOME Calendar builds on
      top of the mature Evolution data server to manage large quantities of events and to provide
      integration with other applications. You can add calendars from various online calendaring
      services (like NextCloud, Google Calendar, and CalDAV / WebDAV servers), enabling you to
      synchronize your events across multiple devices and platforms. GNOME Calendar also supports
      local and offline calendaring, so you can use it anywhere and anytime while travelling
      (or after civilization's collapse.)
    </p>
  </description>

  <!-- These allow us to be found in GNOME Software, as it ignores the description for searching: -->
  <keywords>
    <keyword>calendars</keyword>
    <keyword>calendaring</keyword>
    <keyword>events</keyword>
    <keyword>meetings</keyword>
    <keyword>appointments</keyword>
    <keyword>scheduling</keyword>
    <keyword>planning</keyword>
    <keyword>agenda</keyword>
    <keyword>reminders</keyword>
    <keyword>alarms</keyword>
    <keyword>weather</keyword>
    <keyword>forecasting</keyword>
    <keyword translate="no">iCalendar</keyword>
    <keyword translate="no">ics</keyword>
    <keyword translate="no">CalDAV</keyword>
    <keyword translate="no">WebDAV</keyword>
    <keyword translate="no">Evolution</keyword>
    <keyword translate="no">Nextcloud</keyword>
    <keyword>Google Calendar</keyword>
  </keywords>

  <branding>
    <color type="primary" scheme_preference="light">#c5e1a5</color>
    <color type="primary" scheme_preference="dark">#33691e</color>
  </branding>

  <url type="homepage">https://github.com/Sumon-Kayal/mint-calendar-ce</url>
  <url type="bugtracker">https://github.com/Sumon-Kayal/mint-calendar-ce/issues</url>
  <url type="vcs-browser">https://github.com/Sumon-Kayal/mint-calendar-ce</url>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <recommends>
    <internet>always</internet>
  </recommends>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <translation type="gettext">mint-calendar-ce</translation>
  <launchable type="desktop-id">@appid@.desktop</launchable>
  <provides>
    <binary>mint-calendar-ce</binary>
  </provides>

  <content_rating type="oars-1.1" />

  <update_contact>sumankayalsuman4@proton.me</update_contact>

  <releases>
    <rel. ease version="1.0" type="development" date="2026-08-20>
    
    
    
    
    
    
    
    ">
      <description>
        <p>
          First release of Mint Calendar CE under its own independent version
          scheme. Previously this fork's version number tracked upstream GNOME Calendar's; from
          this release on, it versions independently as its own distributed product. The
          upstream base (GNOME Calendar v50.0 stable) is documented in the description above and
          in the project's README rather than in the version number.
        </p>
        <ul>
          <li>Rebased onto upstream GNOME Calendar's stable v50.0 release, replacing the previous unstable development-snapshot base</li>
          <li>Reapplied Linux Mint's desktop-environment-aware Settings launcher patch on top of the new base</li>
          <li>Rebranded application ID, icons, and launcher entry with Mint-Y-Dark-styled branding</li>
          <li>Added AI-assisted-contribution policy and build documentation</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
